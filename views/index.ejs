<%- layout("/layouts/boilerplate.ejs") %>

  <style>
    #filters {
      flex: 1;
      width: 100%;
      display: flex;
      overflow-x: auto;
      white-space: nowrap;
      padding: 1rem;
      gap: 1rem;

      scroll-behavior: smooth;
    }

    #filters::-webkit-scrollbar {
      display: none;
    }

    .filter {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-width: 60px;
      text-decoration: none;
      color: #555;
      font-size: 0.75rem;
      opacity: 0.7;
      transition: all 0.3s ease;
    }

    .filter i {
      font-size: 1.4rem;
      margin-bottom: 0.3rem;
    }

    .filter:hover {
      opacity: 1;
      transform: translateY(-3px);
    }

    .filter.active {
      opacity: 1;
      color: black;
      border-bottom: 2px solid black;
      padding-bottom: 5px;
    }

    .filter-wrapper {
      display: flex;
      align-items: center;
      gap: 1rem;
      width: 100%;
      border-bottom: 1px solid #ddd;
    }

    /* Filters take full width */
    #filters {
      flex: 1;
      display: flex;
      overflow-x: auto;
      gap: 2rem;
      padding: 1rem 2rem;
    }

    /* Toggle on right */
    .toggle-container {
      flex: 0 0 auto;
      margin-left: 1rem;
      white-space: nowrap;
    }

    /* Arrows */
    .scroll-btn {
      background: white;
      border: none;
      border-radius: 50%;
      padding: 6px;
      cursor: pointer;
      flex: 0 0 auto;
    }

    .scroll-btn.left {
      left: 0;
    }

    .scroll-btn.right {
      right: 350px;
      /* 👈 shift left so it doesn't overlap toggle */
    }

    .tax-info {
      display: none;
    }

    .toggle-container {
      border: 1px solid black;
      border-radius: 1rem;
      height: 3.25rem;
      padding: 1rem;
      align-items: center;
      margin-left: 3rem;
      display: flex;
      align-items: center;
    }
  </style>

  <div class="filter-wrapper">

    <!-- LEFT BUTTON -->
    <button class="scroll-btn left" onclick="scrollFilters(-300)">
      <i class="fa-solid fa-chevron-left"></i>
    </button>

    <!-- FILTERS -->
    <div id="filters">

      <a href="/listings" class="filter <%= !category ? 'active' : '' %>">
        <i class="fa-solid fa-border-all"></i>
        <span>All</span>
      </a>

      <a href="/listings?category=Trendings" class="filter <%= category==='Trendings'?'active':'' %>">
        <i class="fa-solid fa-fire"></i>
        <span>Trendings</span>
      </a>

      <a href="/listings?category=Rooms" class="filter <%= category==='Rooms'?'active':'' %>">
        <i class="fa-solid fa-bed"></i>
        <span>Rooms</span>
      </a>

      <a href="/listings?category=Iconic Cities" class="filter <%= category==='Iconic Cities'?'active':'' %>">
        <i class="fa-solid fa-mountain-city"></i>
        <span>Cities</span>
      </a>

      <a href="/listings?category=Mountains" class="filter <%= category==='Mountains'?'active':'' %>">
        <i class="fa-solid fa-mountain"></i>
        <span>Mountains</span>
      </a>

      <a href="/listings?category=Castles" class="filter <%= category==='Castles'?'active':'' %>">
        <i class="fa-brands fa-fort-awesome"></i>
        <span>Castles</span>
      </a>

      <a href="/listings?category=Amazing Pools" class="filter <%= category==='Amazing Pools'?'active':'' %>">
        <i class="fa-solid fa-person-swimming"></i>
        <span>Pools</span>
      </a>

      <a href="/listings?category=Camping" class="filter <%= category==='Camping'?'active':'' %>">
        <i class="fa-solid fa-campground"></i>
        <span>Camping</span>
      </a>

      <a href="/listings?category=Farms" class="filter <%= category==='Farms'?'active':'' %>">
        <i class="fa-solid fa-cow"></i>
        <span>Farms</span>
      </a>

      <a href="/listings?category=Domes" class="filter <%= category==='Domes'?'active':'' %>">
        <i class="fa-solid fa-igloo"></i>
        <span>Domes</span>
      </a>
      <a href="/listings?category=Boats" class="filter <%= category==='Boats'?'active':'' %>">
        <i class="fa-solid fa-ship"></i>
        <span>Boats</span>
      </a>
      <a href="/listings?category=Arctic" class="filter <%= category==='Arctic'?'active':'' %>">
        <i class="fa-regular fa-snowflake"></i>
        <span>Arctic</span>
      </a>


    </div>

    <!-- RIGHT BUTTON -->
    <button class="scroll-btn right" onclick="scrollFilters(300)">
      <i class="fa-solid fa-chevron-right"></i>
    </button>

    <div class="toggle-container">
      <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" id="switchCheckDefault">
        <label class="form-check-label" for="switchCheckDefault">
          Display total after taxes
        </label>
      </div>
    </div>

  </div>




  <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-3 mt-3">
    <% for( let listing of allListings) { %>

      <a href="/listings/<%= listing._id %>" class="listing-link">

        <div class="card col listing-card">
          <img src="<%= listing.image.url %>" class="card-img-top" style="height: 20rem;" alt="listing-image">
          <div class="card-img-overlay">Hey!</div>
          <div class="card-body">
            <p class="card-text">
              <b>
                <%= listing.title %>
              </b></br>
              &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                <i class="tax-info">&nbsp;&nbsp;+18% GST</i>
            </p>
          </div>


        </div>
      </a>
      <%}%>
  </div>

  <script>
    function scrollFilters(distance) {
      document.getElementById("filters").scrollBy({
        left: distance,
        behavior: "smooth"
      });
    }
    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click", () => {
      let taxInfo = document.getElementsByClassName("tax-info");
      for (info of taxInfo) {
        if (info.style.display != "inline") {
          info.style.display = "inline";
        }
        else {
          info.style.display = "none";
        }
      }
    });
  </script>