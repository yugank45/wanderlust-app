<%- layout("/layouts/boilerplate.ejs") %>

  <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
    <div class="row">
      <div class="col-8 offset-2"><br>
        <h3>Create A NEW LIST</h3>
        <div class="mb-2">
          <label for="title" class="form-label">Title</label>
          <input type="text" name="listing[title]" placeholder="Add a catchy title" class="form-control" required>
          <div class="valid-feedback">
            Title looks good!.
          </div>
        </div>

        <div class="mb-2">
          <label for="description" class="form-label">Description</label>
          <textarea name="listing[description]" placeholder="Enter Description" class="form-control"
            required></textarea>

          <div class="invalid-feedback">
            Please enter a short description!.
          </div>
        </div>

        <!-- <div class="mb-2">
            <label for="image" class="form-label">Image Link</label>
            <input type="text" name="listing[image]" placeholder="enter image URL/Link" class="form-control">
          </div> -->
        <div class="mb-2">
          <label for="image" class="form-label">Upload Image</label>
          <input type="file" name="listing[image]" class="form-control">
        </div>



        <div class="row">
          <div class="mb-2 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input name="listing[price]" placeholder="1200" class="form-control" required>
            <div class="invalid-feedback">
              Please enter a valid price!
            </div>
          </div>

          <div class="mb-2 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input type="text" name="listing[country]" placeholder="India" class="form-control" required>
            <div class="invalid-feedback">
              Please enter a valid country name!.
            </div>
          </div>
        </div>

        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input type="text" name="listing[location]" placeholder="Maharashtra" class="form-control" required>
          <div class="invalid-feedback">
            Location should be valid!.
          </div>
        </div>

        <div class="mb-3">
          <label for="category" class="form-label">Category</label>
          <select name="listing[category]" class="form-control" required>
            <option value="">Select Category</option>
            <option value="Trendings">Trendings</option>
            <option value="Rooms">Rooms</option>
            <option value="Iconic Cities">Iconic Cities</option>
            <option value="Mountains">Mountains</option>
            <option value="Castles">Castles</option>
            <option value="Amazing Pools">Amazing Pools</option>
            <option value="Camping">Camping</option>
            <option value="Farms">Farms</option>
            <option value="Arctic">Arctic</option>
          </select>

          <div class="invalid-feedback">
            Please select a category!
          </div>
        </div>

        <br>
        <button class="btn btn-dark add-btn">Add</button>
        <br><br>

  </form>
  </div>
  </div>