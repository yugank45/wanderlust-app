<%- layout("/layouts/boilerplate.ejs") %>

<div class="row mt-3">
  <h1 class="col-6 offset-3">SignUp On Wanderlust</h1>
  <div class="col-6 offset-3">
    
    <form action="/signup" method="POST" class="needs-validation" novalidate>

      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input type="text" name="username" class="form-control" id="username" placeholder="Enter your username" required>
        <div class="valid-feedback">
          Username looks good!
        </div>
      </div>

      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input type="email" name="email" class="form-control" id="email" placeholder="abc@gmail.com" required>
        <div class="invalid-feedback">
          Email is required!
        </div>
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input type="password" name="password" class="form-control" id="password" placeholder="Password should be at least 6 characters" required>
        <div class="invalid-feedback">
          Password is required!
        </div>
      </div>

      <!-- Add submit button -->
      <button class="btn btn-success">Sign Up</button>

    </form>
  </div>
</div>